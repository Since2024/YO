# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=auto_form_fill

# Application Configuration
DEBUG=True
LOG_LEVEL=INFO

# Paths
TEMPLATES_DIR=/app/templates
DATA_INPUT_DIR=/app/data/input
DATA_OUTPUT_DIR=/app/data/output
LOGS_DIR=/app/logs

# OCR Configuration
OCR_LANGUAGES=en,hi
OCR_USE_GPU=False
