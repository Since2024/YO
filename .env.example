# Database configuration
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=autoformfill

# Optional: enable SQLAlchemy engine logging
# SQLALCHEMY_ECHO=1

# Uncomment to use SQLite for quick local demos
# DB_DRIVER=sqlite
# DB_PATH=data/autoformfill.db

# Tesseract data directory (auto-configured if left blank)
# TESSDATA_PREFIX=/absolute/path/to/tessdata
